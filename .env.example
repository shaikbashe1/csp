# Copy to .env (or run `npm run init-env` to generate one with random secrets)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:54329/healthgap
JWT_SECRET=change-me-long-random
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:3000
LOGIN_RATE_MAX=20
# Bootstrap admin (used only by `npm run seed-admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
# Development-only: return reset token in API response because no email service is configured
DEV_RESET_TOKENS=true
RESEARCH_MIN_GROUP=3
